rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidText(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    // User profile: users/{userId}
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && isValidText(request.resource.data.username, 3, 30)
        && isValidText(request.resource.data.displayName, 1, 50);
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && (request.resource.data.username == resource.data.username || isValidText(request.resource.data.username, 3, 30));
      allow delete: if false;

      // Followers subcollection: users/{userId}/followers/{followerUid}
      match /followers/{followerUid} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == followerUid && followerUid != userId;
        allow delete: if isAuthenticated() && request.auth.uid == followerUid;
      }

      // Following subcollection: users/{userId}/following/{followingUid}
      match /following/{followingUid} {
        allow read: if true;
        allow create: if isOwner(userId) && followingUid != userId;
        allow delete: if isOwner(userId);
      }

      // Blocked users: users/{userId}/blocks/{blockedUid}
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      // User Anime Library: users/{userId}/library/{animeId}
      match /library/{animeId} {
        allow read, write: if isOwner(userId);
      }

      // User Watch Progress: users/{userId}/watch_progress/{animeId}
      match /watch_progress/{animeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unique username registry: usernames/{username}
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Comments: comments/{commentId}
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && isValidText(request.resource.data.content, 1, 2000)
        && request.resource.data.createdAt == request.time;
      allow update: if isAuthenticated() && (
        // Author updating their own comment
        (request.auth.uid == resource.data.authorId
          && isValidText(request.resource.data.content, 1, 2000)
          && request.resource.data.authorId == resource.data.authorId)
        // Public counters: likesCount, replyCount, reportCount
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'replyCount', 'reportCount']))
        // Author soft-delete
        || (request.auth.uid == resource.data.authorId && request.resource.data.isDeleted == true)
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;

      // Likes subcollection: comments/{commentId}/likes/{userId}
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
    }

    // Private Conversations: conversations/{conversationId}
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // Direct Messages: conversations/{conversationId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isValidText(request.resource.data.text, 1, 4000)
          && request.resource.data.timestamp == request.time;
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    // Reports: reports/{reportId}
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
